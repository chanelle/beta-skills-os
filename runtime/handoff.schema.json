{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chanelle/beta-skills-os/runtime/handoff.schema.json",
  "title": "Beta Skills OS agent handoff",
  "description": "Agent-agnostic payload any agent (Claude, Kai, ChatGPT, local) writes to propose or report work. 'proposed' and 'authorized' are not 'executing'; 'executing' is not 'verified'.",
  "type": "object",
  "required": ["handoff_id", "from_agent", "phase", "task", "created_at"],
  "properties": {
    "handoff_id": {"type": "string"},
    "from_agent": {"type": "string", "examples": ["claude", "kai", "chatgpt", "local-qwen"]},
    "to_agent": {"type": ["string", "null"]},
    "phase": {"enum": ["proposed", "authorized", "executing", "verified"]},
    "task": {
      "type": "object",
      "required": ["project", "title", "permission_scope", "acceptance_criteria"],
      "properties": {
        "project": {"type": "string"},
        "title": {"type": "string"},
        "priority": {"type": "integer", "minimum": 1, "maximum": 5},
        "permission_scope": {"enum": ["reversible", "external", "irreversible"]},
        "idempotency_key": {"type": "string"},
        "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["check"]}},
        "input_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "authorization": {
      "type": ["object", "null"],
      "description": "Required when phase is 'authorized' or later and scope is not reversible. Only Chanelle authorizes.",
      "properties": {"approved_by": {"const": "chanelle"}, "approved_at": {"type": "string"}, "scope_note": {"type": "string"}}
    },
    "outputs": {"type": "array", "items": {"type": "string"}},
    "evidence_ids": {"type": "array", "items": {"type": "string"}, "description": "Only set by the verifier, never by the executing agent."},
    "context_already_known": {"type": "array", "items": {"type": "string"}, "description": "Pointers (Notion/Tried Log/GitHub) so the next agent does not ask Chanelle to repeat context."},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"phase": {"const": "verified"}}}, "then": {"required": ["evidence_ids"]}}
  ]
}
